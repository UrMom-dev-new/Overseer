# Optional Overseer runtime configuration.
# Copy this file to .env and fill only the values you need.

# Docker host port. The container itself listens on 3000.
OVERSEER_PORT=3000

# Writable runtime data directory for bounded source snapshots in Docker/web.
# The compose file mounts this at /app/data by default.
OVERSEER_DATA_DIR=
OVERSEER_SNAPSHOT_CACHE=1
OVERSEER_SNAPSHOT_RETENTION_MS=86400000
OVERSEER_SNAPSHOT_MAX_ENTRIES=80

# Optional RECON scanner backend. SCANNER_KEY must match the backend OVERSEER_KEY.
SCANNER_URL=
SCANNER_KEY=

# Optional source credentials.
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_API_KEY=

# Optional source/content controls.
OVERSEER_TELEGRAM_CHANNELS=
GEMINI_API_KEY_1=
SDK_INGEST_KEY=
GITHUB_WEBHOOK_SECRET=
INTEL_URL=
INTEL_PORT=4000
