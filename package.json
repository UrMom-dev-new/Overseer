{
  "name": "overseer",
  "version": "0.1.0",
  "description": "Open source intelligence and reconnaissance dashboard.",
  "author": "Overseer contributors",
  "private": true,
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "node electron/dev-runner.cjs",
    "desktop:start": "next build && electron .",
    "desktop:pack:mac": "next build && electron-builder --mac --arm64 --dir",
    "desktop:dist:mac": "next build && electron-builder --mac --arm64 --publish never",
    "desktop:pack:win": "next build && electron-builder --win --x64 --dir",
    "desktop:dist:win": "next build && electron-builder --win --x64 --publish never",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:integrity": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test": "pnpm run test:integrity",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "smoke:desktop": "node scripts/smoke-electron.mjs",
    "verify:live-sources": "node scripts/verify-live-sources.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "google-libphonenumber": "^3.2.44",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-map-gl": "^8.1.1",
    "rss-parser": "^3.13.0",
    "satellite.js": "^7.0.0",
    "sharp": "^0.34.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
