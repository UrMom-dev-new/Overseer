{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".verify-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/lib/source-contracts.ts",
    "src/lib/source-manifest.ts"
  ],
  "exclude": ["node_modules", ".test-build", ".verify-build"]
}
